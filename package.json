{
  "name": "@ecosy/json",
  "version": "0.1.0",
  "description": "A type-safe JSONPath and JSONQuery engine with zero dependencies",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "agents"
  ],
  "agents": {
    "prompts": {
      "json": "$this://agents/PROMPT.md"
    },
    "rules": {
      "json": "$this://agents/RULES.md"
    },
    "skills": {
      "$overview": "$this://agents/skills/index.md",
      "json-path": "$this://agents/skills/json-path/SKILL.md",
      "json-filter": "$this://agents/skills/json-filter/SKILL.md",
      "json-tokenizer-parser": "$this://agents/skills/json-tokenizer-parser/SKILL.md",
      "json-query": "$this://agents/skills/json-query/SKILL.md",
      "json-pipes": "$this://agents/skills/json-pipes/SKILL.md",
      "json-aggregations": "$this://agents/skills/json-aggregations/SKILL.md",
      "ecosy-json": "$this://agents/skills/ecosy-json/SKILL.md"
    },
    "workflows": [
      "prompts.json",
      "rules.json",
      "skills.json-path",
      "skills.json-filter",
      "skills.json-tokenizer-parser",
      "skills.json-query",
      "skills.json-pipes",
      "skills.json-aggregations",
      "skills.ecosy-json"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokenizer": {
      "types": "./dist/tokenizer.d.ts",
      "import": "./dist/tokenizer.mjs",
      "require": "./dist/tokenizer.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.mjs",
      "require": "./dist/parser.js"
    },
    "./evaluator": {
      "types": "./dist/evaluator.d.ts",
      "import": "./dist/evaluator.mjs",
      "require": "./dist/evaluator.js"
    },
    "./json-path": {
      "types": "./dist/json-path.d.ts",
      "import": "./dist/json-path.mjs",
      "require": "./dist/json-path.js"
    },
    "./json-query": {
      "types": "./dist/json-query.d.ts",
      "import": "./dist/json-query.mjs",
      "require": "./dist/json-query.js"
    }
  },
  "typesVersions": {
    "*": {
      "tokenizer": ["./dist/tokenizer.d.ts"],
      "parser": ["./dist/parser.d.ts"],
      "evaluator": ["./dist/evaluator.d.ts"],
      "json-path": ["./dist/json-path.d.ts"],
      "json-query": ["./dist/json-query.d.ts"]
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "eslint src/ && rollup -c",
    "prepublishOnly": "yarn clean && yarn build",
    "dev": "rollup -c --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/material-atomic/ecosy-json.git"
  },
  "keywords": [
    "ecosy",
    "json",
    "jsonpath",
    "jsonquery",
    "query",
    "typescript"
  ],
  "author": "material-atomic",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
